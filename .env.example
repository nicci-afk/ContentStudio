# Copy to .env and fill in the keys you have. The studio runs without any of
# them (template mode) and unlocks features as keys are added.

# Claude — powers the interview brief, voice DNA, media analysis, and all
# content generation. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for generation.
ANTHROPIC_MODEL=claude-sonnet-5

# ElevenLabs — voice cloning + narration audio. https://elevenlabs.io/
ELEVENLABS_API_KEY=

# HeyGen — photoreal avatar video rendering. https://heygen.com/
HEYGEN_API_KEY=

# Set this on any public deployment (Render, Railway, etc.) — the whole
# studio then requires this password to open. Leave blank for local use.
STUDIO_PASSWORD=

# Magic-link sign-in: comma-separated emails allowed to receive sign-in
# links (in addition to the password). Requires an email sender below.
MAGIC_EMAILS=nicci@travelghr.com, whoskha@gmail.com

# Email sender — configure ONE of these:
# Option A: Resend (resend.com) — one API key.
RESEND_API_KEY=
# Option B: any SMTP (e.g. Gmail with an App Password from
# myaccount.google.com/apppasswords — requires 2-step verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional custom From address (defaults to SMTP_USER / Resend onboarding).
MAGIC_FROM=

PORT=4600
